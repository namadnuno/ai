# ─────────────────────────────────────────────────────────────────
#  Per-project agent sandbox
#
#  This Dockerfile is the ONLY thing you typically need to change
#  per project. Pick a base image that matches your stack and
#  install your project's runtime + tools below.
#
#  REQUIREMENTS (do not remove, the pipeline depends on these):
#    - Node 20+ available somewhere (for Claude Code CLI)
#    - git
#    - A non-root user named "agent" with home /home/agent
#    - WORKDIR /workspace
#  ─────────────────────────────────────────────────────────────────

# ─── Pick your base image ────────────────────────────────────────
# Examples:
#   FROM node:22-slim                  # Node / TS / JS projects
#   FROM python:3.12-slim              # Python projects (then install Node separately, see below)
#   FROM golang:1.23-bookworm          # Go projects
#   FROM rust:1.83-slim                # Rust projects
#   FROM mcr.microsoft.com/dotnet/sdk  # .NET projects

FROM node:22-slim

# ─── Required system deps ────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    git curl jq bash ca-certificates \
    --no-install-recommends \
  && rm -rf /var/lib/apt/lists/*

# ─── Project-specific tools (CUSTOMISE THIS BLOCK) ───────────────
# Add anything your project needs to build/lint/test:
#
# RUN apt-get update && apt-get install -y \
#     postgresql-client \
#     redis-tools \
#     ffmpeg \
#   && rm -rf /var/lib/apt/lists/*
#
# RUN npm install -g pnpm@9
# RUN pip install --no-cache-dir uv
# RUN curl -sSL https://install.python-poetry.org | python3 -

# ─── Required: install Claude Code CLI ───────────────────────────
# (If your base image is NOT Node-based, install Node first, then this.)
RUN npm install -g @anthropic-ai/claude-code

# ─── Required: workspace dirs ────────────────────────────────────
# Dirs must exist and be world-writable — container runs as host UID (unknown at build time)
RUN mkdir -p /workspace /agent && chmod 777 /workspace /agent

WORKDIR /workspace
